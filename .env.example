# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon (serverless Postgres) connection string.
# Powers the real store (Prisma) and the /api/events realtime stream.
# Copy it from the Neon console → Project → Connection details.
# Without it the server falls back to server/data/store.json.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Admin console credentials (defaults: admin / sportylive).
# These are env-only — there is no admin row in Postgres.
ADMIN_USER="admin"
ADMIN_PASS="sportylive"
# Optional: HMAC key for admin session tokens. Defaults to a value derived from
# the credentials, so changing the password signs everyone out.
# ADMIN_SESSION_SECRET="random-long-string"

# AdSense publisher id (the admin console value overrides this at runtime).
# Also used to generate /ads.txt when the admin publisher id is empty.
VITE_ADSENSE_CLIENT="ca-pub-0000000000000000"
# Set to 1 on preview deployments so clicks serve test ads.
VITE_ADSENSE_TEST="0"
